# ---- Set these in Vercel -> Project -> Settings -> Environment Variables ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=clothingstore
JWT_SECRET=change-me-to-a-long-random-string

# The admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Cloudinary (free) - needed to upload product images from the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, used by sitemap.xml and robots.txt
SITE_URL=https://your-site.vercel.app

# Password-reset codes are returned in the API response while no email
# provider is connected. Set to false once real email sending is wired up.
DEMO_SHOW_OTP=true
